<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher icon, foreground layer (on the ic_bg colour): a fuel drop with a gauge in it.
     Everything stays in the adaptive icon's safe zone (circle of radius 33 around the centre).
     The gauge is drawn in the background colour. tools/icon-svg.js reads this file to draw the
     web icons and the store icon, and the logo of the top bar (index.html) is the same drawing. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- the drop -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,26 C54,26 35,49 35,63 C35,73.5 43.5,82 54,82 C64.5,82 73,73.5 73,63 C73,49 54,26 54,26 Z" />
    <!-- the gauge's dial -->
    <path
        android:strokeColor="#1F4E79"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:pathData="M43,68 A11.5,11.5 0 1 1 65,68" />
    <!-- the needle -->
    <path
        android:strokeColor="#1F4E79"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:pathData="M54,65 L61,56" />
    <!-- the needle's hub -->
    <path
        android:fillColor="#1F4E79"
        android:pathData="M50.4,65 A3.6,3.6 0 1 0 57.6,65 A3.6,3.6 0 1 0 50.4,65 Z" />
</vector>
